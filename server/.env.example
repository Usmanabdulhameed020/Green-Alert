NODE_ENV=development
PORT=5000
APP_NAME=GreenAlert
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/greenalert
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email uses the REST API v3 key, not the SMTP key.
# REST API keys usually start with xkeysib-.
BREVO_API_KEY=xkeysib-your-rest-api-key
BREVO_SENDER_NAME=GreenAlert
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SMTP_LOGIN=

TERMII_API_KEY=
TERMII_SENDER_ID=
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GEMINI_API_KEY=
MAP_KEY=

# Admin seed (creates/promotes admin account on startup)
ADMIN_EMAIL=admin@greenalert.com
ADMIN_PASSWORD=your-secure-admin-password
# Admin phone number for SMS alerts (international format e.g. +2348012345678). Leave blank to disable.
ADMIN_PHONE=


# Rate limiting (requests per window)
# Auth endpoints have stricter limit (20 per 15min)
